{
  "$schema":"../nono-profile.schema.json",
  "meta": {
    "name": "Proxy credentials for OpenCode inference"
  },
  "network": {
    "block": false,
    "allow_domain": ["opencode.ai/inference/go"],
    "credentials": ["opencode-go"],
    "custom_credentials": {
      "opencode-go": {
        "upstream": "https://opencode.ai/inference/go/openai/v1",
        "credential_key": "opencode",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      }
    }
  },
  "env_credentials": {},
  "hooks": {},
  "rollback": {
    "exclude_patterns": [],
    "exclude_globs": []
  }
}
